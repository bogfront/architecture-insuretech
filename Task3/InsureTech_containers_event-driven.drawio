    <!-- TRANSACTIONAL OUTBOX EXPLANATION -->
    <mxCell id="160" value="&lt;b&gt;Transactional Outbox:&lt;/b&gt;&lt;br/&gt;Запись в БД + outbox table в одной транзакции.&lt;br/&gt;Relay читает outbox и публикует в Kafka.&lt;br/&gt;Гарантирует at-least-once delivery.&lt;br/&gt;Предотвращает потерю событий при сбое." style="rounded=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;html=1;whiteSpace=wrap;align=left;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="20" y="790" width="280" height="100" as="geometry" />
    </mxCell>

