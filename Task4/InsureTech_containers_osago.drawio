    <mxCell id="121" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;(client-info schema)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
