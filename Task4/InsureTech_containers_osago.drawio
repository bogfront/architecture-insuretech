    <mxCell id="104a" value="&lt;b&gt;Страховые компании (10)&lt;/b&gt;&lt;br/&gt;Продукты и тарифы&lt;br/&gt;[External: REST API]" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;html=1;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="1660" y="280" width="200" height="80" as="geometry" />
    </mxCell>
    <mxCell id="104b" value="&lt;b&gt;Страховые компании (10)&lt;/b&gt;&lt;br/&gt;ОСАГО: create_quote + get_quote&lt;br/&gt;[External: REST API]&lt;br/&gt;Макс. время ответа: 60с" style="rounded=1;arcSize=10;fillColor=#f5f5f5;strokeColor=#666666;html=1;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="1660" y="560" width="200" height="100" as="geometry" />
    </mxCell>

    <!-- API Gateway -->
    <mxCell id="105" value="&lt;b&gt;API Gateway (Nginx Ingress)&lt;/b&gt;&lt;br/&gt;[Container: Nginx]&lt;br/&gt;RL: Rate Limiting (Task 6), SSL, Routing" style="rounded=1;arcSize=10;fillColor=#d5e8d4;strokeColor=#82b366;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="680" y="80" width="280" height="80" as="geometry" />
    </mxCell>

    <!-- ===== CORE-APP ===== -->
    <mxCell id="110" value="&lt;b&gt;core-app&lt;/b&gt;&lt;br/&gt;[Container: K8s, Spring Boot]&lt;br/&gt;Оформление страховок, витрина,&lt;br/&gt;локальная реплика тарифов,&lt;br/&gt;оркестрация ОСАГО-заявок,&lt;br/&gt;WebSocket сервер (офферы ОСАГО)" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="330" y="270" width="240" height="130" as="geometry" />
    </mxCell>
    <mxCell id="111" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;(core-app schema)&lt;br/&gt;+ Outbox table" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
