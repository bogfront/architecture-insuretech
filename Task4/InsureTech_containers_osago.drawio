    <!-- TITLE -->
    <mxCell id="100" value="InsureTech — C4 Container Diagram (ОСАГО + Event-Driven, to-be)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1" vertex="1" parent="1">
      <mxGeometry x="200" y="10" width="1400" height="50" as="geometry" />
    </mxCell>

    <!-- LEGEND -->
    <mxCell id="101" value="&lt;b&gt;Легенда:&lt;/b&gt;&lt;br/&gt;Синий — внутренние контейнеры&lt;br/&gt;Зелёный — инфраструктура&lt;br/&gt;Серый — внешние системы&lt;br/&gt;Красный — БД&lt;br/&gt;Фиолетовый — брокер сообщений&lt;br/&gt;--- Оранжевый --- WebSocket&lt;br/&gt;--- Красный --- с паттернами CB/TO/RT" style="rounded=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;html=1;whiteSpace=wrap;align=left;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="60" width="210" height="140" as="geometry" />
    </mxCell>

