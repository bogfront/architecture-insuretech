    <!-- ===== KAFKA ===== -->
    <mxCell id="130" value="&lt;b&gt;Apache Kafka&lt;/b&gt;&lt;br/&gt;[Container: Message Broker]&lt;br/&gt;Topics:&lt;br/&gt;  products.updated&lt;br/&gt;  policies.created&lt;br/&gt;  osago.application.created&lt;br/&gt;  osago.offer.received" style="rounded=1;arcSize=5;fillColor=#8a2be2;strokeColor=#4B0082;fontColor=#ffffff;html=1;whiteSpace=wrap;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="720" y="360" width="270" height="150" as="geometry" />
    </mxCell>

    <!-- ===== INS-PRODUCT-AGGREGATOR ===== -->
    <mxCell id="140" value="&lt;b&gt;ins-product-aggregator&lt;/b&gt;&lt;br/&gt;[Container: K8s]&lt;br/&gt;Агрегирует тарифы СК.&lt;br/&gt;Publishes: products.updated" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1180" y="270" width="230" height="110" as="geometry" />
    </mxCell>
    <mxCell id="141" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;(aggregator + Outbox)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="1180" y="420" width="175" height="75" as="geometry" />
    </mxCell>
    <mxCell id="142" value="&lt;b&gt;Outbox Relay&lt;/b&gt;" style="rounded=1;arcSize=50;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="1060" y="390" width="110" height="55" as="geometry" />
    </mxCell>

    <!-- ===== OSAGO-AGGREGATOR ===== -->
    <mxCell id="160" value="&lt;b&gt;osago-aggregator&lt;/b&gt;&lt;br/&gt;[Container: K8s, НОВЫЙ]&lt;br/&gt;Отправляет заявки в СК.&lt;br/&gt;Опрашивает статусы (polling).&lt;br/&gt;Publishes: osago.offer.received&lt;br/&gt;Subscribes: osago.application.created&lt;br/&gt;Хранит состояние заявок в БД." style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1430" y="420" width="240" height="160" as="geometry" />
    </mxCell>
    <mxCell id="161" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;(osago schema)&lt;br/&gt;Заявки + статусы офферов" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="1430" y="620" width="190" height="80" as="geometry" />
    </mxCell>

    <!-- ===== INS-COMP-SETTLEMENT ===== -->
    <mxCell id="150" value="&lt;b&gt;ins-comp-settlement&lt;/b&gt;&lt;br/&gt;[Container: K8s]&lt;br/&gt;Взаиморасчёты.&lt;br/&gt;Subscribes: policies.created,&lt;br/&gt;products.updated" style="rounded=1;arcSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="1180" y="630" width="230" height="120" as="geometry" />
    </mxCell>
    <mxCell id="151" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br/&gt;(settlement)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="1180" y="790" width="175" height="75" as="geometry" />
    </mxCell>

    <!-- Resilience patterns annotation -->
    <mxCell id="163" value="&lt;b&gt;Паттерны отказоустойчивости&lt;br/&gt;(osago-aggregator → СК):&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;CB — Circuit Breaker: отключение&lt;br/&gt;   недоступных/медленных СК&lt;br/&gt;TO — Timeout: 60с на каждую СК&lt;br/&gt;   (требование бизнеса)&lt;br/&gt;RT — Retry: 3 попытки с backoff&lt;br/&gt;   (в рамках 60с таймаута)&lt;br/&gt;RL — Rate Limit: исходящих&lt;br/&gt;   запросов к каждой СК&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Multi-instance:&lt;/b&gt;&lt;br/&gt;Kafka Consumer Group гарантирует,&lt;br/&gt;что каждая заявка обработана&lt;br/&gt;ровно одним экземпляром.&lt;br/&gt;&lt;b&gt;WebSocket routing:&lt;/b&gt;&lt;br/&gt;Redis pub/sub для fan-out офферов&lt;br/&gt;к нужному экземпляру core-app." style="rounded=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;html=1;whiteSpace=wrap;align=left;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="20" y="250" width="285" height="360" as="geometry" />
    </mxCell>

