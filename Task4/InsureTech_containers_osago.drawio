    <mxCell id="102" value="&lt;b&gt;Веб-приложение (SPA)&lt;/b&gt;&lt;br/&gt;[Container: React]&lt;br/&gt;Клиентский браузер" style="rounded=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="290" y="80" width="200" height="80" as="geometry" />
    </mxCell>
    <mxCell id="103" value="&lt;b&gt;B2B Партнёры&lt;/b&gt;&lt;br/&gt;[External]" style="rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;html=1;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
      <mxGeometry x="1660" y="80" width="180" height="70" as="geometry" />
